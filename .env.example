# Anthropic (Claude) API anahtarınız — https://console.anthropic.com adresinden alabilirsiniz
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# En iyi anları seçmek için kullanılacak model.
# Daha hızlı/ucuz için: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# Whisper transkript modeli: tiny, base, small, medium, large-v3
# Daha büyük model = daha doğru ama daha yavaş
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Kliplere otomatik altyazı gömülsün mü?
BURN_SUBTITLES=true

DOWNLOADS_DIR=downloads
OUTPUTS_DIR=outputs
